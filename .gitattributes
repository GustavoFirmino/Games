# O repo é editado no Windows, mas os projetos são compilados no macOS.
# Normalizar tudo para LF evita ruído em diff e problemas no Xcode.
* text=auto eol=lf

*.swift    text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.pbxproj  text eol=lf merge=union
*.xcscheme text eol=lf

*.png  binary
*.jpg  binary
*.pdf  binary
*.mp3  binary
*.wav  binary
